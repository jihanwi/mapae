{
  "crons": [{"path": "/api/cron/index", "schedule": "*/15 * * * *"}],
  "rewrites": [
    {"source": "/t/:curve", "destination": "/api/meta?share=:curve"},
    {"source": "/waitlist/callback", "destination": "/api/waitlist?action=callback"},
    {"source": "/waitlist", "destination": "/api/waitlist?action=land"},
    {"source": "/w/:code", "destination": "/api/waitlist?share=:code"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data: blob: https://*.public.blob.vercel-storage.com; connect-src 'self' https://sepolia-rpc.giwa.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{"type": "host", "value": "mapae-gasok-7k2.vercel.app"}],
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]
    }
  ]
}
